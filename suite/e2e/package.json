{
  "name": "@suite/e2e",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "test": "yarn test:productivity",
    "test:productivity": "playwright test -c productivity/playwright.config.ts",
    "test:meet": "playwright test -c meet/playwright.config.ts",
    "test:headed": "yarn test:productivity --headed",
    "test:debug": "yarn test:productivity --debug",
    "test:ui": "yarn test:productivity --ui",
    "test:report": "playwright show-report productivity/playwright-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^24.10.1",
    "typescript": "^6.0.3"
  }
}
